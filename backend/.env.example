PORT=5000
NODE_ENV=development
AI_SERVICE_URL=http://127.0.0.1:8000
CORS_ORIGIN=http://localhost:5173

# Auth
JWT_SECRET=change-this-to-a-random-32-char-string-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_EXPIRES_IN=7d

# PostgreSQL
# Local development:
#   DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/comm_readiness
#
# Supabase — use the DIRECT connection (port 5432) for migrations and the app.
# Find it in Supabase Dashboard → Settings → Database → Connection string → URI.
# Do NOT use the connection pooler URL (port 6543) for migrations — DDL fails there.
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://<user>:<password>@127.0.0.1:<port>/comm_readiness

# File uploads
UPLOAD_MAX_FILE_SIZE_MB=5
UPLOAD_DIR=uploads

# Redis — required for audio turn caching (M1 sessionContextService)
# Local: start with `docker run -p 6379:6379 redis:alpine` or install redis-server
# Cloud: Upstash Redis URL (redis://default:<token>@<host>:6379)
# If unset, turn caching is disabled but audio turns still function via direct DB writes.
REDIS_URL=redis://localhost:6379
