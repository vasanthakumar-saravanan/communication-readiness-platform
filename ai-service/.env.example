# LLM Provider selection
# Presets: groq | openai | together | anthropic | ollama | lmstudio | vllm | mock
LLM_PROVIDER=groq

# Generic API key — used by all cloud providers
LLM_API_KEY=

# Generic model override — defaults to the provider preset if left blank
LLM_MODEL=

# Explicit base URL — overrides preset (use for custom/local/self-hosted endpoints)
# Example (Ollama):    http://localhost:11434/v1
# Example (vLLM):      http://localhost:8000/v1
# Example (LM Studio): http://localhost:1234/v1
# Example (custom):    http://your-server.internal/v1
LLM_BASE_URL=

# Legacy Groq vars (still accepted for backward compat)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

DEBUG=false

# Shared secret for POST /ai/config — Node.js backend sends this as X-Internal-Key.
# Change to a strong random string in production. POST /ai/config returns 403 without it.
# NOTE: POST /ai/config only works reliably with --workers 1 (the dev default).
# Each worker holds its own os.environ copy; calling /ai/config updates only one worker.
INTERNAL_API_KEY=change-me
